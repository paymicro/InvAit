<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.1738743">
    <PropertyGroup>
        <BuildCommand>npm run compile</BuildCommand>

        <JavaScriptTestRoot>src\test\</JavaScriptTestRoot>
        <JavaScriptTestFramework>Mocha</JavaScriptTestFramework>
        <JavaScriptTestCommand>npm run test:unit</JavaScriptTestCommand>

        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
        <ResolveNuGetPackages>false</ResolveNuGetPackages>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <Target Name="VSTest" DependsOnTargets="Test" />

    <ItemGroup>
        <Folder Include="node_modules\" />
    </ItemGroup>

    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <TypeScriptCompile Include="src\test\**\*.test.ts" />
    </ItemGroup>
</Project>