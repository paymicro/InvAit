{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha", "chai", "sinon"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
