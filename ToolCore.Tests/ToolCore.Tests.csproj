<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="23.0.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageReference Include="xunit.v3.runner.console" Version="4.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestAssets\**" />
    <Content Remove="TestAssets\**" />
    <None Remove="TestAssets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpHost\McpHost.csproj" />
    <ProjectReference Include="..\ToolCore\ToolCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TestAssets\EchoMcpServer\EchoMcpServer.csproj" />
    <ProjectReference Include="TestAssets\HttpEchoMcpServer\HttpEchoMcpServer.csproj" />
  </ItemGroup>

</Project>
