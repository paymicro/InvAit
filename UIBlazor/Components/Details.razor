@implements IDisposable
<div class="custom-details @(_isExpanded ? "is-expanded" : "") @(IsRounded ? "is-rounded" : "") @CustomClass">
    <div class="header" @onclick="Toggle">
        <div class="header-left">
            @if (HeaderTemplate is not null)
            {
                @HeaderTemplate
            }
            else
            {
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <i class="@Icon icon-spacing"></i>
                }
                @Text
            }
        </div>
        <span class="arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"
            fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 3 5 5-5 5"></path>
        </svg>
        </span>
    </div>
    <div class="content-wrapper">
        <div class="content-inner">
            @* Collapsed content can be skipped entirely. The wrapper hides it with
               grid-template-rows: 0fr, but the children still live in the DOM - a streaming
               reasoning block was re-parsed and re-rendered on every token while invisible.
               With RenderContentWhenCollapsed=false nothing exists in the DOM until the user
               opens the block, so a long think-block costs nothing while collapsed. *@
            @if (RenderContentWhenCollapsed || _isExpanded || _bodyPinned)
            {
                @ChildContent
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    // Кастомное содержимое заголовка; заменяет собой Icon + Text
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    // Задает только НАЧАЛЬНОЕ состояние раскрытости. Дальше состояние внутреннее:
    // повторные перерендеры родителя не должны сбрасывать выбор пользователя.
    [Parameter] public bool IsExpanded { get; set; }

    /// <summary>
    /// Whether the child content is rendered while collapsed. Default <c>true</c> keeps the
    /// original behaviour (content always in the DOM, hidden by CSS) - required where the body
    /// must survive the toggle: tool results, diffs, sub-agent transcripts.
    /// <para>
    /// Set to <c>false</c> for content that is expensive and/or streams: a collapsed block then
    /// holds nothing in the DOM and is built once when the user expands it.
    /// </para>
    /// </summary>
    [Parameter] public bool RenderContentWhenCollapsed { get; set; } = true;

    /// <summary>
    /// How long the body is kept after a collapse started, so the height can animate.
    /// Must cover the CSS transition on <c>grid-template-rows</c> (0.3s) plus a frame.
    /// </summary>
    private const int CollapseAnimationMs = 320;

    /// <summary>
    /// True while a collapsing body must stay in the DOM so the transition has something to
    /// shrink. Without it the body disappears on the same frame the class is removed and the
    /// block snaps shut - the lazy rendering would silently kill the animation.
    /// </summary>
    private bool _bodyPinned;

    private CancellationTokenSource? _unpinCts;

    /// <summary>
    /// Колбэк клика по заголовку (контролируемый режим, напр. SubAgentView).
    /// Когда задан, клик НЕ меняет _isExpanded напрямую — источник истины родитель:
    /// он обновляет IsExpanded и перерендеривается, а OnParametersSet синхронизирует
    /// внутреннее состояние с внешним. Это позволяет родителю принудительно
    /// раскрывать/сворачивать блок (напр. оркестратор сабагента при апруве и Finish).
    /// </summary>
    [Parameter] public Action<bool>? OnToggle { get; set; }
    [Parameter] public bool IsRounded { get; set; }

    private bool _isExpanded;

    protected override void OnInitialized() => _isExpanded = IsExpanded;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Контролируемый режим: следуем внешнему состоянию при каждом родительском
        // рендере (принудительное раскрытие при апруве, сворачивание после Finish).
        if (OnToggle is not null)
            _isExpanded = IsExpanded;
    }

    // Позволяет передавать любые другие атрибуты RadzenSwitch (напр. Title, TabIndex)
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Извлекаем строку класса, если она есть
    private string CustomClass => AdditionalAttributes?.ContainsKey("class") == true
                                      ? AdditionalAttributes["class"].ToString() ?? ""
                                      : "";

    private void Toggle()
    {
        if (OnToggle is not null)
        {
            OnToggle(!_isExpanded);
            return;
        }

        SetExpanded(!_isExpanded);
    }

    /// <summary>
    /// Applies the new expansion state, keeping the body alive for the duration of the collapse
    /// animation when the content is otherwise rendered lazily.
    /// </summary>
    private void SetExpanded(bool expanded)
    {
        CancelPendingUnpin();

        if (!expanded && !RenderContentWhenCollapsed)
        {
            // Pin first: the body must exist while grid-template-rows animates 1fr -> 0fr.
            _bodyPinned = true;
            _isExpanded = false;
            ScheduleUnpin();
            return;
        }

        _bodyPinned = false;
        _isExpanded = expanded;
    }

    private void ScheduleUnpin()
    {
        var cts = new CancellationTokenSource();
        _unpinCts = cts;
        _ = UnpinAsync(cts);
    }

    private async Task UnpinAsync(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(CollapseAnimationMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // expanded again before the animation finished
        }

        // Disposed while waiting: StateHasChanged on a removed component throws.
        if (cts.IsCancellationRequested)
            return;

        _bodyPinned = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelPendingUnpin()
    {
        var cts = _unpinCts;
        _unpinCts = null;
        if (cts is null)
            return;

        cts.Cancel();
        cts.Dispose();
    }

    public void Dispose()
    {
        var cts = _unpinCts;
        _unpinCts = null;
        cts?.Cancel();
        cts?.Dispose();
    }
}