@implements IDisposable

@*
    ToolTimeoutBadge renders the execution clock of a single tool call. It is rendered by the
    result area of ToolCallBlock: in the progress line while the tool runs and in the result
    block header once the result arrived.

    The clock itself does NOT live here: it is stamped on the ToolCall model by
    ToolCallHandler — ExecutionStartedAtUtc right before the tool body is invoked
    (AFTER the approval is resolved) and ExecutionElapsedMs right after the result is
    assigned. That makes the model the single source of truth:
    - the approval wait is never counted (the call is not executed while Pending);
    - a call approved up-front (Allow mode) but still queued behind other tool calls
      is not counted either — the stamp lands when its own execution starts;
    - the measured value survives this component being re-created (re-render, session
      switch) and, for the finished state, a session reload.

    Lifecycle (driven entirely by the model):
    - no stamp, no duration — nothing is rendered (pending approval, rejected calls,
      ask_user, tools that never executed);
    - stamp set, duration unknown — DECREASING countdown of the timeout. The timeout
      value is snapshotted on the first observation, so changing the setting mid-flight
      does not move a running countdown. At zero the badge turns into the "expired" style;
    - duration set (tool finished) — the badge STAYS and shows the measured execution
      time (start → result); the timer stops and the ticker is disposed;
    - TimeoutMs <= 0 (no configured limit) — no countdown, but the measured duration is
      still reported once the tool finishes.

    IMPORTANT: this component does NOT inherit ThrottledComponentBase. ToolCallBlock
    throttles its re-renders (~10fps, gated by HasChanges()); the countdown must tick
    independently, so it owns a timer and calls InvokeAsync(StateHasChanged) directly,
    re-rendering only when the displayed text or the expired/finished state changed.
    Start/finish transitions arrive through ToolCall.ExecutionClockChanged — the handler
    stamps the clock outside the render cascade and nothing else would re-render the header
    while a tool runs.
*@

@if (ShowBadge)
{
    <Tooltip Text="@TooltipText">
        <RadzenBadge class="@CssClass" BadgeStyle="@BadgeStyleOf" Variant="Variant.Text">
            @if (IsFinished)
            {
                <i class="fa-regular fa-clock"></i>
            }
            @TimeText
        </RadzenBadge>
    </Tooltip>
}

@code {
    /// <summary>Tick interval of the countdown timer (~2 fps is enough for a m:ss display).</summary>
    private static readonly TimeSpan TickInterval = TimeSpan.FromMilliseconds(500);

    /// <summary>
    /// Finished tools faster than this are not reported: a "0:00" badge on every instant
    /// tool would be pure noise. The measured value stays on the model regardless.
    /// </summary>
    private const long MinVisibleElapsedMs = 1_000;

    /// <summary>The tool call whose execution clock is displayed.</summary>
    [Parameter] public ToolCall ToolCall { get; set; } = null!;

    /// <summary>
    /// Total timeout in ms (CommonOptions.ToolTimeoutMs or the per-sub-agent limit);
    /// &lt;= 0 means there is nothing meaningful to count down from (a non-positive SETTING is
    /// resolved by the host to the tool default, so the run is still bounded — only the countdown
    /// and the expired state do not apply), so the running badge is hidden.
    /// The finished badge (measured duration) is shown regardless.
    /// </summary>
    [Parameter] public int TimeoutMs { get; set; }

    private System.Threading.Timer? _timer;
    private ToolCall? _observedToolCall;
    private int? _timeoutSnapshot;
    private bool _disposed;
    private string _lastText = string.Empty;
    private bool _lastExpired;
    private bool _lastFinished;

    protected override void OnParametersSet()
    {
        // ToolCall is a mutable reference: a re-render may pass the same instance with new
        // timestamps (start/finish). Only a genuinely different instance resets the state.
        if (!ReferenceEquals(_observedToolCall, ToolCall))
        {
            SubscribeToClock(ToolCall);
            _timeoutSnapshot = null;
            _lastText = string.Empty;
            _lastExpired = false;
            _lastFinished = false;
        }

        SyncTimer();
    }

    /// <summary>
    /// The handler stamps the execution clock outside the render cascade: without this
    /// subscription a long-running tool would never show its badge (nothing else re-renders
    /// the header while the tool runs). Re-keyed when the parameter instance changes.
    /// </summary>
    private void SubscribeToClock(ToolCall toolCall)
    {
        if (_observedToolCall is not null)
            _observedToolCall.ExecutionClockChanged -= OnExecutionClockChanged;

        _observedToolCall = toolCall;
        toolCall.ExecutionClockChanged += OnExecutionClockChanged;
    }

    private void OnExecutionClockChanged()
    {
        if (_disposed)
            return;

        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;

            SyncTimer();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Keeps the ticker alive exactly while the countdown runs: created on the first
    /// observation of a running call, disposed as soon as the call finishes/goes away.
    /// </summary>
    private void SyncTimer()
    {
        if (!ShowBadge || !IsRunning)
        {
            StopTimer();
            return;
        }

        // Snapshot the timeout once: a settings change must not shift a running countdown.
        _timeoutSnapshot ??= TimeoutMs;

        _timer ??= new System.Threading.Timer(OnTick, null, TickInterval, TickInterval);
    }
    private void StopTimer()
    {
        if (_disposed)
            return;

        var timer = _timer;
        _timer = null;
        timer?.Dispose();
    }

    /// <summary>
    /// Timer callback runs on a thread-pool thread: marshal into the renderer sync context,
    /// but only when the visible state actually changed — otherwise every 500ms tick would
    /// re-render the whole tool-call block chain.
    /// </summary>
    private void OnTick(object? state)
    {
        if (_disposed)
            return;

        var text = TimeText;
        var expired = Expired;
        var finished = IsFinished;

        if (text == _lastText && expired == _lastExpired && finished == _lastFinished)
            return;

        _lastText = text;
        _lastExpired = expired;
        _lastFinished = finished;

        if (finished || !ShowBadge || !IsRunning)
            StopTimer();

        Render();
    }

    private void Render()
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Component removed between the _disposed check and the dispatch.
        }
        catch (InvalidOperationException)
        {
            // Renderer already detached (Dispose raced the tick) — nothing to render.
        }
    }

    /// <summary>
    /// Execution finished and the duration is worth showing. A sub-second tool keeps the
    /// measured value on the model but shows no badge ("0:00" on every instant call is noise).
    /// </summary>
    protected bool IsFinished => ToolCall.ExecutionElapsedMs is { } elapsedMs && elapsedMs >= MinVisibleElapsedMs;

    /// <summary>
    /// Execution is running right now: start stamped, duration not measured yet. The duration
    /// check (not the <see cref="IsFinished"/> one) is what matters here — otherwise a tool
    /// that finished below <see cref="MinVisibleElapsedMs"/> would look like it is still running.
    /// </summary>
    protected bool IsRunning => ToolCall.ExecutionElapsedMs is null && ToolCall.ExecutionStartedAtUtc is not null;

    /// <summary>
    /// The badge is visible for a call that is executing (countdown, needs a positive timeout
    /// to have something to count down from) or that has a measured execution time.
    /// The finished state does NOT depend on TimeoutMs: a tool run without any configured limit
    /// still reports how long it took — the timeout is merely absent from the story.
    /// </summary>
    protected bool ShowBadge => IsFinished || (TimeoutMs > 0 && IsRunning);

    /// <summary>Countdown reached zero while the tool is still running.</summary>
    protected bool Expired => IsRunning && RemainingMs <= 0;

    /// <summary>Remaining time in ms of the running call, measured from the execution stamp.</summary>
    protected double RemainingMs
    {
        get
        {
            var total = _timeoutSnapshot ?? TimeoutMs;
            if (ToolCall.ExecutionStartedAtUtc is not { } startedAt)
                return total;

            return total - (DateTime.UtcNow - startedAt).TotalMilliseconds;
        }
    }

    /// <summary>Countdown text while running, measured duration once finished.</summary>
    protected string TimeText => IsFinished
        ? FormatClock(ToolCall.ExecutionElapsedMs!.Value, roundUp: false)
        : FormatClock(Math.Max(0, RemainingMs), roundUp: true);

    /// <summary>Formats a duration as m:ss (2:00, 1:05, 0:00).</summary>
    private static string FormatClock(double ms, bool roundUp)
    {
        var seconds = roundUp
            ? (long)Math.Ceiling(Math.Max(0, ms) / 1000.0)
            : (long)Math.Round(Math.Max(0, ms) / 1000.0);

        return $"{seconds / 60}:{seconds % 60:D2}";
    }

    /// <summary>Countdown explains the limit, the finished badge explains the spent time.</summary>
    protected string TooltipText => IsFinished
        ? SharedResource.ToolExecutionTime
        : SharedResource.ToolRequestTimeoutSec;

    protected string CssClass => IsFinished
        ? "tool-timeout-elapsed"
        : Expired
            ? "tool-timeout-expired"
            : "tool-timeout-badge";

    protected BadgeStyle BadgeStyleOf => IsFinished
        ? BadgeStyle.Success
        : Expired
            ? BadgeStyle.Warning
            : BadgeStyle.Base;

    public void Dispose()
    {
        if (_disposed)
            return;

        _disposed = true;
        if (_observedToolCall is not null)
            _observedToolCall.ExecutionClockChanged -= OnExecutionClockChanged;

        _timer?.Dispose();
        _timer = null;
    }
}
