@inject IVsBridge VsBridge
@inject NotificationService NotificationService
@inject UiErrorLogger UiErrorLogger
@using DiffPlex
@using DiffPlex.Chunkers
@using DiffPlex.DiffBuilder
@using DiffPlex.DiffBuilder.Model

<div class="diff-view">
    @if (!string.IsNullOrEmpty(FilePath))
    {
        @* No @key here: during streaming the path GROWS ("src/A" -> "src/App.cs"), so a keyed
           header was disposed and rebuilt on nearly every chunk — taking the Tooltip wrappers
           (whose Dispose closes the tooltip under the cursor) and the open-file button with it.
           Nothing in the header holds identity-dependent state. *@
        <div class="tool-file-header">
            <span class="tool-file-path">@FilePath</span>
            @* replaceAll and dryRun are properties of the CALL, and both were invisible: the only
               place they could be read was the raw JSON. They are counted over the edits actually
               received, so a partially streamed batch shows a partial count instead of a guess. *@
            @if (ReplaceAllCount > 0)
            {
                <Tooltip Text="@string.Format(SharedResource.EditReplaceAllTooltip, ReplaceAllCount, EditCount)">
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Text" class="tool-replaceall-badge">
                        <i class="fa-solid fa-arrows-rotate"></i> @string.Format(SharedResource.EditReplaceAllBadge, ReplaceAllCount, EditCount)
                    </RadzenBadge>
                </Tooltip>
            }
            @if (DryRun)
            {
                <Tooltip Text="@SharedResource.EditDryRunTooltip">
                    @* Warning, not Info: the badge reports that NOTHING was written. "Info" reads as a
                       neutral remark about a completed action, and the one mistake this badge exists
                       to prevent is taking a simulated diff for a real write. *@
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Text" class="tool-dryrun-badge">
                        <i class="fa-solid fa-flask"></i> @SharedResource.EditDryRunBadge
                    </RadzenBadge>
                </Tooltip>
            }
            <button class="tool-file-open-btn" @onclick="OpenFileInIdeAsync"
                    title="@SharedResource.OpenFileInIde">
                <i class="fas fa-external-link-alt"></i>
            </button>
        </div>
    }
    <div class="diff-block">
        @for (var i = 0; i < diffs.Count && i < _edits.Length; i++)
        {
            @if (diffs[i] is null)
            {
                continue;
            }
            @if (i > 0)
            {
                <hr />
            }
            <DiffViewSection Model="diffs[i]!" PositionOffset="_edits[i]?.ApproximateLine - 1 ?? 0" />
        }
    </div>
</div>

@code {
    [Parameter] public string FilePath { get; set; } = null!;
    [Parameter] public DiffEdit[] Edits { get; set; } = [];

    /// <summary>
    /// The call's <c>dryRun</c> argument: the edits were only simulated, nothing was written.
    /// Worth a badge because a successful-looking diff is otherwise indistinguishable from a write.
    /// </summary>
    [Parameter] public bool DryRun { get; set; }

    /// <summary>
    /// How many of the received edits carry <c>replaceAll: true</c>. Counted rather than shown as a
    /// flag: the flag alone hides WHICH edit replaces everything, and a batch may mix both kinds.
    /// <para>
    /// Recomputed in <see cref="OnParametersSet"/> next to the diff parsing, not on every read:
    /// the header is re-rendered on each streamed args chunk, and a property would walk the whole
    /// batch each time.
    /// </para>
    /// </summary>
    private int ReplaceAllCount { get; set; }

    /// <summary>
    /// How many edits the call carries, i.e. the denominator of the badge. Without it `×N` was
    /// ambiguous: next to a result that reported "4 replacements" a reader takes N for the number
    /// of replacements, while N is the number of EDITS that asked for `replaceAll`. The actual
    /// replacement count cannot be shown here at all — it depends on the FILE, and is only known
    /// after the host runs the call.
    /// </summary>
    private int EditCount { get; set; }

    private List<SideBySideDiffModel?> diffs = [];

    /// <summary>Нормализованный (не-null) массив edit'ов текущего рендера.</summary>
    private DiffEdit?[] _edits = [];

    /// <summary>Сумма длин предыдущего разбора (-1 — форсирует первый разбор).</summary>
    private int processedChars = -1;

    /// <summary>Количество edit'ов предыдущего разбора (-1 — форсирует первый разбор).</summary>
    private int processedCount = -1;

    // Троттлинг уже есть
    // в родителе ToolCallBlock (100ms) — он гейтит частоту пушей параметров. Вложенный
    // ThrottledComponentBase с собственным 500ms-окном и отложенным парсингом создавал
    // гонку двух «поздних» звеньев: при быстром стриме (< 1с) финальный контент терялся —
    // рендер ветоился HasChanges=false (processedChars уже обновлён), а trailing-render
    // откладывался/отменялся каскадом родителя. Теперь парсинг синхронный в OnParametersSet:
    // пришедшие Edits ВСЕГДА попадают в diffs до ближайшего рендера.
    //
    // Цена: до ~10 разборов/сек (гейт ToolCallBlock) вместо ~2/сек на UI-потоке WASM.
    // Осознанный размен в пользу корректности: приходящие Edits не должны откладываться.
    protected override void OnParametersSet()
    {
        _edits = Edits ?? [];

        var sumChars = 0;
        var replaceAllCount = 0;
        var editCount = 0;
        foreach (var e in _edits)
        {
            if (e is null)
            {
                continue;
            }
            editCount++;
            if (e.ReplaceAll is true)
            {
                replaceAllCount++;
            }
            // `DiffEdit.OldStr`/`NewStr` объявлены non-nullable с инициализатором `string.Empty`,
            // но System.Text.Json СТАВИТ null, если в payload пришло `"oldStr": null` —
            // инициализатор в таком случае не применяется. Без `?.` здесь падал NRE внутри
            // OnParametersSet, то есть валился весь блок тул-вызова: пользователь не видел ни
            // диффа, ни заголовка файла, ни причины — только пустое место.
            sumChars += (e.NewStr?.Length ?? 0) + (e.OldStr?.Length ?? 0);
        }

        // The badge must follow the args even when the diff itself does not change: flipping
        // replaceAll on an already-parsed edit leaves sumChars and the count identical, so the
        // assignment sits OUTSIDE the re-parse gate.
        ReplaceAllCount = replaceAllCount;
        EditCount = editCount;

        // Сравнение по НЕРАВЕНСТВУ (не по росту) + по количеству: усадка массива или
        // замена на равный по сумме контент иначе оставили бы навсегда устаревший дифф.
        if (sumChars != processedChars || _edits.Length != processedCount)
        {
            ParseDiff(sumChars);
        }
    }

    /// <summary>
    /// Открывает файл в IDE через shared-хелпер (open_file уже реализован на хостах VS/VS Code).
    /// При ошибке хоста — notification (Console.Error невидим в релизе).
    /// </summary>
    private async Task OpenFileInIdeAsync()
    {
        if (string.IsNullOrEmpty(FilePath))
        {
            return;
        }

        var result = await VsBridge.OpenFileInIdeAsync(FilePath);
        if (!result.Success)
        {
            NotificationService.NotifyError(UiErrorLogger, SharedResource.OpenFileInIde, result.ErrorMessage, "OpenFile", showProgress: false);
        }
    }

    private void ParseDiff(int sumChars)
    {
        // Инвариант: diffs.Count == _edits.Length. Удерживаем его здесь, чтобы разметка
        // могла безопасно индексировать оба массива (раньше граница была по diffs.Count,
        // а индекс в Edits — при усадке это IndexOutOfRangeException в BuildRenderTree,
        // которая рвёт всё поддерево сообщения, а не только блок диффа).
        if (diffs.Count > _edits.Length)
        {
            diffs.RemoveRange(_edits.Length, diffs.Count - _edits.Length);
        }

        // Дополняться новыми строками может только ПОСЛЕДНИЙ DiffModel (стриминг args
        // растёт с конца; предыдущие edit'ы финальны) — перепарсиваем только его.
        var start = Math.Max(0, diffs.Count - 1);

        for (var i = start; i < _edits.Length; i++)
        {
            var editRepl = _edits[i];
            var model = editRepl is null ? null : BuildDiff(editRepl);

            if (i < diffs.Count)
            {
                diffs[i] = model;
            }
            else
            {
                diffs.Add(model);
            }
        }

        processedChars = sumChars;
        processedCount = _edits.Length;
    }

    // `?? string.Empty`: DiffPlex не принимает null и бросает ArgumentNullException внутри
    // ParseDiff — то есть уже после того, как сумма длин посчитана. Причина та же, что выше:
    // JSON мог прислать `"oldStr": null` в обход инициализатора свойства.
    private static SideBySideDiffModel BuildDiff(DiffEdit edit)
        => SideBySideDiffBuilder.Diff(
            Differ.Instance,
            edit.OldStr ?? string.Empty,
            edit.NewStr ?? string.Empty,
            false,
            false,
            lineChunker: LineChunker.Instance,
            wordChunker: CharacterChunker.Instance
        );
}
