@inject IVsBridge VsBridge
@inject NotificationService NotificationService
@inject UiErrorLogger UiErrorLogger
@using DiffPlex
@using DiffPlex.Chunkers
@using DiffPlex.DiffBuilder
@using DiffPlex.DiffBuilder.Model

<div class="diff-view">
    @if (!string.IsNullOrEmpty(FilePath))
    {
        <div @key="@FilePath" class="tool-file-header">
            <span class="tool-file-path">@FilePath</span>
            <button class="tool-file-open-btn" @onclick="OpenFileInIdeAsync"
                    title="@SharedResource.OpenFileInIde">
                <i class="fas fa-external-link-alt"></i>
            </button>
        </div>
    }
    <div class="diff-block">
        @for (var i = 0; i < diffs.Count && i < _edits.Length; i++)
        {
            @if (diffs[i] is null)
            {
                continue;
            }
            @if (i > 0)
            {
                <hr />
            }
            <DiffViewSection Model="diffs[i]!" PositionOffset="_edits[i]?.ApproximateLine - 1 ?? 0" />
        }
    </div>
</div>

@code {
    [Parameter] public string FilePath { get; set; } = null!;
    [Parameter] public DiffEdit[] Edits { get; set; } = [];

    private List<SideBySideDiffModel?> diffs = [];

    /// <summary>Нормализованный (не-null) массив edit'ов текущего рендера.</summary>
    private DiffEdit?[] _edits = [];

    /// <summary>Сумма длин предыдущего разбора (-1 — форсирует первый разбор).</summary>
    private int processedChars = -1;

    /// <summary>Количество edit'ов предыдущего разбора (-1 — форсирует первый разбор).</summary>
    private int processedCount = -1;

    // Троттлинг уже есть
    // в родителе ToolCallBlock (100ms) — он гейтит частоту пушей параметров. Вложенный
    // ThrottledComponentBase с собственным 500ms-окном и отложенным парсингом создавал
    // гонку двух «поздних» звеньев: при быстром стриме (< 1с) финальный контент терялся —
    // рендер ветоился HasChanges=false (processedChars уже обновлён), а trailing-render
    // откладывался/отменялся каскадом родителя. Теперь парсинг синхронный в OnParametersSet:
    // пришедшие Edits ВСЕГДА попадают в diffs до ближайшего рендера.
    //
    // Цена: до ~10 разборов/сек (гейт ToolCallBlock) вместо ~2/сек на UI-потоке WASM.
    // Осознанный размен в пользу корректности: приходящие Edits не должны откладываться.
    protected override void OnParametersSet()
    {
        _edits = Edits ?? [];

        var sumChars = 0;
        foreach (var e in _edits)
        {
            if (e is null)
            {
                continue;
            }
            sumChars += e.NewStr.Length + e.OldStr.Length;
        }

        // Сравнение по НЕРАВЕНСТВУ (не по росту) + по количеству: усадка массива или
        // замена на равный по сумме контент иначе оставили бы навсегда устаревший дифф.
        if (sumChars != processedChars || _edits.Length != processedCount)
        {
            ParseDiff(sumChars);
        }
    }

    /// <summary>
    /// Открывает файл в IDE через shared-хелпер (open_file уже реализован на хостах VS/VS Code).
    /// При ошибке хоста — notification (Console.Error невидим в релизе).
    /// </summary>
    private async Task OpenFileInIdeAsync()
    {
        if (string.IsNullOrEmpty(FilePath))
        {
            return;
        }

        var result = await VsBridge.OpenFileInIdeAsync(FilePath);
        if (!result.Success)
        {
            NotificationService.NotifyError(UiErrorLogger, SharedResource.OpenFileInIde, result.ErrorMessage, "OpenFile", showProgress: false);
        }
    }

    private void ParseDiff(int sumChars)
    {
        // Инвариант: diffs.Count == _edits.Length. Удерживаем его здесь, чтобы разметка
        // могла безопасно индексировать оба массива (раньше граница была по diffs.Count,
        // а индекс в Edits — при усадке это IndexOutOfRangeException в BuildRenderTree,
        // которая рвёт всё поддерево сообщения, а не только блок диффа).
        if (diffs.Count > _edits.Length)
        {
            diffs.RemoveRange(_edits.Length, diffs.Count - _edits.Length);
        }

        // Дополняться новыми строками может только ПОСЛЕДНИЙ DiffModel (стриминг args
        // растёт с конца; предыдущие edit'ы финальны) — перепарсиваем только его.
        var start = Math.Max(0, diffs.Count - 1);

        for (var i = start; i < _edits.Length; i++)
        {
            var editRepl = _edits[i];
            var model = editRepl is null ? null : BuildDiff(editRepl);

            if (i < diffs.Count)
            {
                diffs[i] = model;
            }
            else
            {
                diffs.Add(model);
            }
        }

        processedChars = sumChars;
        processedCount = _edits.Length;
    }

    private static SideBySideDiffModel BuildDiff(DiffEdit edit)
        => SideBySideDiffBuilder.Diff(
            Differ.Instance,
            edit.OldStr,
            edit.NewStr,
            false,
            false,
            lineChunker: LineChunker.Instance,
            wordChunker: CharacterChunker.Instance
        );
}
