@inject IToolManager ToolManager

<div class="tool-call-block" data-tool="@ToolCall.Function.Name">
    <div class="tool-call-header @StatusClass">
        @SharedResource.CallingTool: <strong>@DisplayName</strong>
        @if (!ToolCall.IsReady)
        {
            <i class="fa-regular fa-hourglass fa-spin"></i>
        }
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Variant="Variant.Text" title="Tokens for tool">
            ~@ToolCall.Tokens tokens
        </RadzenBadge>
    </div>

    @if (ToolCall.Function.Arguments.Length > 0)
    {
        <div class="tool-call-args">
            @if (ToolCall.Function.Name == BuiltInToolEnum.Edits)
            {
                var template = new
                {
                    filePath = default(string),
                    edits = default(DiffEdit[])
                };
                var result = JsonUtils.DeserializeAnonymousType(ToolCall.Function.Arguments, template);
                <DiffView FilePath="@result.filePath" Edits="@result.edits" />
            }
            else if (ToolCall.Function.Name == BuiltInToolEnum.CreateFile)
            {
                var template = new
                {
                    filePath = default(string),
                    content = default(string)
                };
                var result = JsonUtils.DeserializeAnonymousType(ToolCall.Function.Arguments, template);
                <ToolCreateNewFile FilePath="template.filePath" Args="@template.content" />
            }
            else if (ToolCall.Function.Name == BasicEnum.AskUser)
            {
                <ToolAskOptions Args="@ToolCall.Function.Arguments" />
            }
            else
            {
                <pre>@ToolCall.Function.Arguments</pre>
            }
        </div>
    }

    @if (ToolCall.IsReady)
    {
        <div class="tool-approval-footer @StatusClass">
            @if (ToolCall.ApprovalStatus == ToolApprovalStatus.Pending)
            {
                <div class="tool-approval-label"><i class="rz-icon-notification rz-ml-2"></i>@SharedResource.ApproveRequired</div>
                <div class="tool-approval-actions">
                    <RadzenButton Icon="check" class="tool-approve-btn rz-m-2" Click="@(async () => await OnApproval.InvokeAsync((ToolCall.Id, true)))" />
                    <RadzenButton Icon="close" class="tool-reject-btn rz-m-2" Click="@(async () => await OnApproval.InvokeAsync((ToolCall.Id, false)))" />
                </div>
            }
        </div>
        @if (ToolCall.Result is not null)
        {
            <Details Text="@ToolCall.Result.DisplayName">
                <pre class="rz-p-2 rz-background-color-base-900 rz-color-white">@ToolCall.Result.Content</pre>
            </Details>
        }
    }
</div>

@code {
    [Parameter] public ToolCall ToolCall { get; set; } = null!;
    [Parameter] public EventCallback<(string SegmentId, bool Approved)> OnApproval { get; set; }

    private string DisplayName => ToolManager.GetTool(ToolCall.Function.Name)?.DisplayName ?? ToolCall.Function.Name;

    private string StatusClass => ToolCall.ApprovalStatus switch
    {
        ToolApprovalStatus.Approved => "approved",
        ToolApprovalStatus.Rejected => "rejected",
        _ => "pending" // класс по умолчанию
    };
}
