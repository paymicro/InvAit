@inject IToolManager ToolManager
@inject IToolCallHandler ToolCallHandler
@inject IContentFilter ContentFilter
@inherits ThrottledComponentBase
@implements IDisposable

@*
    ToolCallBlock renders a single tool call: arguments, approval buttons, result.
    When ToolCallHandlerOverride is set (e.g. by SubAgentView), ask_user answers
    and approvals are routed to that handler instead of the DI-injected one.
*@

<div class="tool-call-block" data-tool="@ToolCall.Function.Name" data-toolcall-id="@ToolCall.Id">
    @* Весь блок сворачивается через Details; заголовок повторяет прежний .tool-call-header
       (стиль задается в app.css через переопределение .header). IsExpanded — только начальное
       состояние (true), внутреннее состояние Details переживает перерендеры родителя. *@
    <Details IsExpanded="true" class="@($"tool-call-details {StatusClass}")">
        <HeaderTemplate>
            @if (!ToolCall.IsReady)
            {
                <i class="fa-regular fa-hourglass fa-spin"></i>
            }
            <span>@SharedResource.CallingTool:</span>
            <strong>@DisplayName</strong>
            @if (ToolCall.IsReady && ToolCall.Result is null)
            {
                <i class="fa-regular fa-hourglass fa-spin"></i> <span>@SharedResource.CallingToolAwait</span>
            }
        </HeaderTemplate>
        <ChildContent>

        @if (ToolCall.Function.Arguments.Length > 2) // json object: {}
        {
            <div class="tool-call-args">
                @if (ToolCall.Function.Name == BuiltInToolEnum.EditFiles)
                {
                    var result = new
                    {
                        filePath = default(string),
                        edits = default(DiffEdit[])
                    };
                    result = JsonUtils.DeserializeAnonymousType(ToolCall.Function.Arguments, result);
                    <DiffView FilePath="@(result.filePath ?? string.Empty)" Edits="@(result.edits ?? [])" />
                }
                else if (ToolCall.Function.Name == BuiltInToolEnum.CreateFile)
                {
                    var result = new
                    {
                        filePath = default(string),
                        content = default(string)
                    };
                result = JsonUtils.DeserializeAnonymousType(ToolCall.Function.Arguments, result);
                    <ToolCreateNewFile FilePath="@(result.filePath ?? string.Empty)" Content="@(result.content ?? string.Empty)" />
                }
                else if (ToolCall.Function.Name == BasicEnum.AskUser)
                {
                    <ToolAskOptions Args="@ToolCall.Function.Arguments"
                                    Answer="@ToolCall.Result?.Content"
                                    OnOptionSelectedCallback="@(async (answer) => await OnAskUserAnswer(answer))" />
                }
                else if (ToolCall.Function.Name == BuiltInToolEnum.DelegateTask)
                {
                    <DelegateTaskView Args="@ToolCall.Function.Arguments" />
                }
                else
                {
                    <JsonArgsView Args="@ToolCall.Function.Arguments" />
                }
            </div>
        }

        @if (ToolCall.IsReady && ToolCall.Function.Name != BasicEnum.AskUser)
        {
            <div class="tool-approval-footer @StatusClass">
                @if (ToolCall.ApprovalStatus == ToolApprovalStatus.Pending)
                {
                    <div class="tool-approval-label"><i class="rz-icon-notification rz-ml-2"></i>@SharedResource.ApproveRequired</div>
                    <div>
                        <i class="fa-solid fa-exclamation fa-bounce" style="--fa-animation-delay: 0.1s;"></i>
                        <i class="fa-solid fa-exclamation-triangle fa-bounce" style="font-size:larger"></i>
                        <i class="fa-solid fa-exclamation fa-bounce" style="--fa-animation-delay: 0.1s;"></i>
                    </div>
                    <div class="tool-approval-actions">
                        <RadzenButton Icon="check" class="tool-approve-btn rz-m-2" Click="@(async () => await OnApproval.InvokeAsync((ToolCall.Id, true)))" />
                        <RadzenButton Icon="close" class="tool-reject-btn rz-m-2" Click="@(async () => await OnApproval.InvokeAsync((ToolCall.Id, false)))" />
                    </div>
                }
            </div>

            @* Sub-agent views: one per delegated task *@
            @if (ToolCall.Function.Name == BuiltInToolEnum.DelegateTask && _subAgents is { Count: > 0 })
            {
                @foreach (var subAgent in _subAgents)
                {
                    <SubAgentView SubAgent="@subAgent" />
                }
            }
            else if (ToolCall.Result is not null)
            {
                <Details>
                    <HeaderTemplate>
                        <span>@ToolCall.Result.DisplayName</span>
                        @if (ContentFilter.IsActive)
                        {
                            <Tooltip Text="@SharedResource.ContentFilterMinimized">
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Text">
                                    <i class="fa-solid fa-compress"></i> @SharedResource.ContentFilterMinimized
                                </RadzenBadge>
                            </Tooltip>
                        }
                        <Tooltip Text="Tokens for tool">
                            <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Text">
                                ~@ToolCall.Tokens tokens
                            </RadzenBadge>
                        </Tooltip>
                    </HeaderTemplate>
                    
                    <ChildContent>
                        @* Intentionally using <pre> instead of <MarkdownBlock> here.
                           Tool results are typically plain text (file contents, command output, JSON),
                           not markdown. Rendering as markdown would misformat raw text.
                           FileContentFormatter deserializes structured FileContent JSON (from read_files)
                           and adds line numbers. Non-file tools fall back to raw text. *@
                        <pre class="rz-p-2">@(FileContentFormatter.FormatContent(ToolCall.Result.Content))</pre>
                    </ChildContent>
                </Details>
            }
        }
        </ChildContent>
    </Details>
</div>

@code {
    [Parameter] public ToolCall ToolCall { get; set; } = null!;
    [Parameter] public EventCallback<(string SegmentId, bool Approved)> OnApproval { get; set; }
    /// <summary>
    /// When set (e.g. by SubAgentView), overrides the DI-injected ToolCallHandler.
    /// ask_user answers are routed to this handler.
    /// </summary>
    [Parameter] public IToolCallHandler? ToolCallHandlerOverride { get; set; }

    /// <summary>
    /// Throttle per-token sub-agent state events to ~10fps. SubAgentMessage.StateChanged
    /// fires on EVERY streaming delta; without a gate each raise re-renders this block
    /// (and queues work into the WASM sync queue), flooding the renderer and freezing
    /// clicks while a branch streams. Structural changes bypass the throttle via
    /// <see cref="HasChanges"/> (status, attach, approval) — they are rare and must land.
    /// </summary>
    protected override int RenderIntervalMs => 100;

    private int _lastSubAgentCount = -1;
    private int _lastApprovalStatus = -1;
    private bool _lastHasResult;
    private int _lastArgsLength = -1;

    /// <summary>
    /// Structural changes (status, attach, approval, RESULT) render immediately; streamed
    /// args growth is throttled to ~10fps. Args growth MUST be in the snapshot: ToolCall is
    /// a mutable reference (arguments grow inside it), so the parent cascade formally passes
    /// unchanged parameters — without the args check ShouldRender would return false, the
    /// block would not re-render, the args would never be re-deserialized and DiffView
    /// would never receive the new Edits (the diff showed only the final result).
    /// </summary>
    protected override bool HasChanges()
    {
        var status = (int)ToolCall.ApprovalStatus;
        var count = ToolCall.SubAgents?.Count ?? 0;
        var hasResult = ToolCall.Result is not null;
        var argsLength = ToolCall.Function.Arguments.Length;

        var changed = status != _lastApprovalStatus ||
                      count != _lastSubAgentCount ||
                      hasResult != _lastHasResult ||
                      argsLength != _lastArgsLength;
        if (changed)
        {
            _lastApprovalStatus = status;
            _lastSubAgentCount = count;
            _lastHasResult = hasResult;
            _lastArgsLength = argsLength;
        }
        return changed;
    }

    protected override void OnRendered()
    {
        _lastApprovalStatus = (int)ToolCall.ApprovalStatus;
        _lastSubAgentCount = ToolCall.SubAgents?.Count ?? 0;
        _lastHasResult = ToolCall.Result is not null;
        _lastArgsLength = ToolCall.Function.Arguments.Length;
    }

    private bool _disposed;
    private List<SubAgentMessage> _subAgents = [];
    private ToolCall? _subscribedToolCall;

    protected override void OnInitialized()
    {
        SubscribeToToolCall(ToolCall);
    }

    /// <summary>
    /// Subscribes to SubAgentsChanged for live attach discovery (e.g. nested batches).
    /// Re-keyed on every ToolCall parameter change: an owner-bump cascade may be skipped
    /// by the renderer for unchanged-parameter components, so the subscription must
    /// survive parameter re-assignment (reference-check, unsubscribe the old instance).
    /// </summary>
    private void SubscribeToToolCall(ToolCall toolCall)
    {
        if (ReferenceEquals(_subscribedToolCall, toolCall))
            return;

        if (_subscribedToolCall is not null)
            _subscribedToolCall.SubAgentsChanged -= OnSubAgentsChanged;

        _subscribedToolCall = toolCall;
        toolCall.SubAgentsChanged += OnSubAgentsChanged;
    }

    private void OnSubAgentsChanged()
        => InvokeAsync(() =>
        {
            // StateHasChanged без смены параметров НЕ вызывает OnParametersSet —
            // синхронизируем подписки StateChanged здесь же, иначе поздний attach
            // (напр. nested batch) не получит подписку и его ветка не будет live.
            SyncSubAgentSubscriptions();
            StateHasChanged();
        });

    private string DisplayName => ToolManager.GetTool(ToolCall.Function.Name)?.DisplayName ?? ToolCall.Function.Name;

    /// <summary>
    /// Sub-agent's handler when inside SubAgentView, otherwise the main DI-injected handler.
    /// </summary>
    private IToolCallHandler EffectiveHandler => ToolCallHandlerOverride ?? ToolCallHandler;

    private string StatusClass => ToolCall.ApprovalStatus switch
    {
        ToolApprovalStatus.Approved => "approved",
        ToolApprovalStatus.Rejected => "rejected",
        _ => "pending" // класс по умолчанию
    };

    protected override void OnParametersSet()
    {
        // Re-key the SubAgentsChanged subscription when the ToolCall parameter changes
        // (see SubscribeToToolCall) and refresh sub-agent StateChanged subscriptions.
        SubscribeToToolCall(ToolCall);
        SyncSubAgentSubscriptions();
    }

    /// <summary>
    /// Subscribes to sub-agent state changes for live UI updates.
    /// Copy the list: storing the live ToolCall.SubAgents reference would make
    /// SequenceEqual compare the list to itself (always true) and late attaches
    /// would never get subscribed.
    /// </summary>
    private void SyncSubAgentSubscriptions()
    {
        var currentSubAgents = ToolCall.SubAgents ?? [];
        if (currentSubAgents.SequenceEqual(_subAgents))
            return;

        foreach (var old in _subAgents)
            old.StateChanged -= OnSubAgentStateChanged;
        _subAgents = [.. currentSubAgents];
        foreach (var fresh in currentSubAgents)
            fresh.StateChanged += OnSubAgentStateChanged;
    }

    private void OnSubAgentStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnAskUserAnswer(string answer)
    {
        await EffectiveHandler.HandleAskUserAnswerAsync(ToolCall.Id, answer);
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        if (_subscribedToolCall is not null)
            _subscribedToolCall.SubAgentsChanged -= OnSubAgentsChanged;
        foreach (var subAgent in _subAgents)
            subAgent.StateChanged -= OnSubAgentStateChanged;
    }
}
