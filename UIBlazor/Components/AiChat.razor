@inherits RadzenComponent

<div @ref="@Element" @attributes="Attributes" class="rz-chat rz-h-100" id="@GetId()">
    <!-- Chat Header -->
    <RadzenStack class="rz-chat-header"
        Orientation="Orientation.Horizontal"
        AlignItems="AlignItems.Center"
        JustifyContent="JustifyContent.SpaceBetween"
        Gap="0.5rem">
        <UsageIndicators class="hide-350" />
        @if (_isCompressing)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" title="@SharedResource.Compressing">
                <i class="fa-solid fa-compress fa-spin"></i> @SharedResource.Compressing
            </RadzenBadge>
        }
        <RadzenStack class="rz-chat-header-actions"
            Orientation="Orientation.Horizontal"
            AlignItems="AlignItems.End"
            JustifyContent="JustifyContent.End"
            Gap="0.5rem"
            Style="flex:1">
            @if (ProfileManager.Current.Profiles.Count > 0)
            {
                <RadzenDropDown
                    TValue="string"
                    Data="@ProfileManager.Current.Profiles"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Value="@ProfileManager.Current.ActiveProfileId"
                    Change="@OnProfileChangeAsync"
                    Placeholder="Select Profile"
                    class="hide-500"
                    Style="width: 180px;" />
            }
            <Tooltip Text="@SharedResource.NewSession">
                <RadzenButton
                    Icon="add_comment"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="@NewSessionAsync"
                    class="rz-chat-header-new" />
            </Tooltip>
            <Tooltip Text="@SharedResource.Settings">
                <RadzenButton
                    Icon="settings"
                    Variant="Variant.Text"
                    ButtonStyle="ButtonStyle.Base"
                    Click="@OnShowSettingsAsync"
                    IsBusy="@_callSettings"
                    class="rz-chat-header-settings" />
            </Tooltip>
        </RadzenStack>
    </RadzenStack>

    @* Chat Messages: the transcript is windowed - head + archive plaque + tail. See MessageListView *@
    <div class="rz-chat-messages" >
        @{
            var messages = GetMessagesSnapshot();
            if (messages.Count == 0)
            {
                <RecentSessionsPicker ShowTitle=true />
            }
            else
            {
                <MessageListView @ref="_messageList"
                                 Messages="messages"
                                 SessionId="ChatService.Session.Id"
                                 IsLoading="IsLoading"
                                 IsCompressing="_isCompressing"
                                 OnToolApproval="HandleToolApprovalAsync"
                                 OnExecutePlan="ExecutePlanAsync"
                                 OnEdit="OnEditMessage"
                                 OnCancelEdit="OnCancelEdit"
                                 OnSaveEdit="OnSaveEditAsync"
                                 OnDelete="OnDeleteMessageAsync"
                                 OnRegenerate="OnRegenerateLastAsync"
                                 OnCompress="CompressFromPlaqueAsync" />
            }
        }
    </div>

    <!-- Chat Input -->
    <AiChatInput
        IsLoading="IsLoading"
        SendMessage="SendMessageAsync"
        Cancel="CancelResponseAsync"
        CommandTriggered="HandleCommandAsync"
        OnCompressRequested="CompressFromPlaqueAsync">
    </AiChatInput>
</div>
